    <!-- Boot -->
    <string name="boot_prompt">amkyaw@server:~$ ./boot.sh</string>
    <string name="boot_cursor">_</string>
    <string name="boot_line_1">[ OK ] Initializing amkyaw kernel...</string>
    <string name="boot_line_2">[ OK ] Loading network modules...</string>
    <string name="boot_line_3">[ OK ] Scanning WiFi interface...</string>
    <string name="boot_line_4">[ OK ] Binding port :8080</string>
    <string name="boot_line_5">[ OK ] Establishing peer links...</string>
    <string name="boot_line_6">[ OK ] Connecting telegram relay...</string>
    <string name="boot_line_7">[ OK ] amkyaw server ONLINE</string>

