    <string name="dash_title">amkyaw@server:~/</string>
    <string name="dash_status_cmd">$ amkyaw --status</string>
    <string name="dash_chat_cmd">$ ./start_chat.sh</string>
    <string name="dash_relay_cmd">$ ./telegram_relay.sh</string>
    <string name="dash_label_ip">[+] IP      :</string>
    <string name="dash_label_user">[+] USER    :</string>
    <string name="dash_label_port">[+] PORT    :</string>
    <string name="dash_label_state">[+] STATE   :</string>
    <string name="dash_port_value">8080 (WebSocket)</string>
    <string name="dash_state_online">ONLINE</string>
    <string name="dash_state_offline">OFFLINE</string>
    <string name="dash_btn_open_chat">[ &gt;_ OPEN_CHAT ]</string>
    <string name="dash_btn_activate_bot">[ &gt;_ ACTIVATE_BOT ]</string>
    <string name="dash_btn_stop_bot">[ &gt;_ DEACTIVATE_BOT ]</string>
    <string name="dash_hint_token">[ENTER] BOT_TOKEN</string>
    <string name="dash_footer">[ SECURE LAN · END-TO-END LOCAL ]</string>
    <string name="dash_unknown_ip">0.0.0.0:8080</string>

