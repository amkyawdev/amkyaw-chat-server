    <string name="chat_title">amkyaw@chat:~$</string>
    <string name="chat_live">[LIVE]</string>
    <string name="chat_input_prompt">&gt;</string>
    <string name="chat_input_hint">type message...</string>
    <string name="chat_send">[SEND_]</string>
    <string name="chat_back">&lt; EXIT</string>

