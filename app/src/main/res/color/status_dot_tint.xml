<?xml version="1.0" encoding="utf-8"?>
<!-- Live status dot: colour follows connection state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/status_online" />
    <item android:state_activated="true" android:color="@color/status_connecting" />
    <item android:color="@color/status_offline" />
</selector>
