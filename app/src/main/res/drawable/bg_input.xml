<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal input field: square, 1dp glowing green border.
     Focused state brightens the border (cursor is the neon block). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/neon_green_bright" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/neon_green" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>
