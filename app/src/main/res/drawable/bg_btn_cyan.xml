<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary (cyan) terminal button: dim fill, 1dp cyan border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_btn_cyan" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/cyan_bright" />
            <corners android:radius="@dimen/bubble_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_btn_cyan" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/cyan_bright" />
            <corners android:radius="@dimen/bubble_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_alt" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/cyan" />
            <corners android:radius="@dimen/bubble_radius" />
        </shape>
    </item>
</selector>
